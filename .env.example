# Copy this to .env and fill in your key(s). Never commit the real .env.
# Powers the chat assistant (optional -- the dashboard works fully without
# it, the chat panel just reports it can't reach a language model).
#
# Pick ONE provider. If more than one is filled in, priority is
# Azure > OpenAI > DeepSeek.

# Option A: your own Azure AI Foundry / Azure OpenAI deployment.
# AZURE_OPENAI_API_KEY  -- from the Azure resource's "Keys and Endpoint" page.
#   This is a 32-character hex string, NOT the same thing as an "sk-..."
#   OpenAI platform key even if the underlying model is the same GPT.
# AZURE_OPENAI_ENDPOINT -- same page, looks like https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT -- the deployment NAME you chose in Foundry when you
#   deployed the model (not necessarily "gpt-4.1" itself -- whatever you typed
#   as the deployment name is what goes here).
# AZURE_OPENAI_API_VERSION -- optional, defaults to a recent one below.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Option B: a direct platform.openai.com API key (starts with sk- or
# sk-proj-). No endpoint/deployment/api-version needed, those are Azure-only
# concepts -- just the key and the model name.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Option C: DeepSeek (default, no corporate account needed).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
